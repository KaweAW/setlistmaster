# Copy to .env.local (local) or set in your host's environment settings (Vercel / Cloudflare / Netlify).
# Both are public values (the anon key is meant to be in the browser; the database rules protect the data).
# Leave them out and the app works exactly as before, on this device only.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY
